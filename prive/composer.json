{
    "name": "salw/conseiller-sam",
    "description": "Dépendances du site Sam : SDK Anthropic officiel, client HTTP, FPDI et FPDF (marquage des livres numériques).",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "anthropic-ai/sdk": "^0.52",
        "guzzlehttp/guzzle": "^7.9",
        "setasign/fpdi": "^2.6",
        "setasign/fpdf": "^1.8"
    },
    "config": {
        "platform": { "php": "8.1.0" },
        "optimize-autoloader": true,
        "allow-plugins": { "php-http/discovery": false }
    }
}
